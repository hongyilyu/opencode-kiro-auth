{
  "name": "@hongyilyu/opencode-kiro-auth",
  "version": "2.2.0",
  "description": "Use Kiro models in opencode with AWS Builder ID, IAM Identity Center, or Kiro API-key authentication. Includes Claude 5, GPT 5.6, effort variants, and built-in web search.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts"
  },
  "license": "MIT",
  "author": "Toan Doan <toandev.95@gmail.com>",
  "contributors": [
    "Hongyi Lyu (fork maintainer)"
  ],
  "homepage": "https://github.com/hongyilyu/opencode-kiro-auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongyilyu/opencode-kiro-auth.git"
  },
  "bugs": {
    "url": "https://github.com/hongyilyu/opencode-kiro-auth/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "kiro",
    "kiro-cli",
    "codewhisperer",
    "amazon-q",
    "aws-sso"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.ts",
    "src",
    "script",
    "opencode.example.jsonc",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check-auth": "bun run script/check-auth.ts",
    "list-models": "bun run script/list-models.ts",
    "test-model": "bun run script/test-model.ts",
    "test-websearch": "bun run script/test-websearch.ts"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "5.9.3"
  }
}
