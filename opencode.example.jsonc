{
  // Merge this into ~/.config/opencode/opencode.json.
  // (~ resolves to your home directory on all OSes, including Windows.)
  "$schema": "https://opencode.ai/config.json",

  // Load the plugin from npm. Pin a version with @<version> if you want,
  // e.g. "@hongyilyu/opencode-kiro-auth@2.0.1". Alternatives:
  //   - GitHub: "github:hongyilyu/opencode-kiro-auth"
  //   - Local dev: "file:///ABSOLUTE/PATH/TO/opencode-kiro-auth"
  "plugin": ["@hongyilyu/opencode-kiro-auth@latest"],

  "provider": {
    "kiro": {
      "name": "Kiro",
      // Driven through the Anthropic AI SDK provider; the plugin intercepts every
      // request and routes it to Kiro, so baseURL is only a placeholder.
      "npm": "@ai-sdk/anthropic",
      "options": { "baseURL": "https://kiro.local" },

      // limits/modalities mirror Kiro's ListAvailableModels. `variants` are the
      // effort levels Kiro exposes per model; the plugin maps the selected variant
      // name to Kiro's additionalModelRequestFields (output_config.effort for Claude,
      // reasoning.effort for GPT), so the values can stay empty here.
      "models": {
        "auto": {
          "name": "Auto",
          "limit": { "context": 1000000, "output": 64000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
        },
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "limit": { "context": 1000000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {},
            "max": {},
          },
        },
        "claude-fable-5": {
          "name": "Claude Fable 5",
          "limit": { "context": 1000000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {},
            "max": {},
          },
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "limit": { "context": 1000000, "output": 64000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {},
            "max": {},
          },
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "limit": { "context": 272000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "none": {},
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {},
            "max": {},
          },
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra",
          "limit": { "context": 272000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "none": {},
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {},
            "max": {},
          },
        },
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna",
          "limit": { "context": 272000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "none": {},
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {},
            "max": {},
          },
        },
        "claude-opus-4.8": {
          "name": "Claude Opus 4.8",
          "limit": { "context": 1000000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {},
            "max": {},
          },
        },
        "claude-opus-4.7": {
          "name": "Claude Opus 4.7",
          "limit": { "context": 1000000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {},
            "max": {},
          },
        },
        "claude-opus-4.6": {
          "name": "Claude Opus 4.6",
          "limit": { "context": 1000000, "output": 64000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": {},
            "medium": {},
            "high": {},
            "max": {},
          },
        },
        "claude-sonnet-4.6": {
          "name": "Claude Sonnet 4.6",
          "limit": { "context": 1000000, "output": 64000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "low": {},
            "medium": {},
            "high": {},
            "max": {},
          },
        },
        "claude-opus-4.5": {
          "name": "Claude Opus 4.5",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
        },
        "claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
        },
        "claude-sonnet-4": {
